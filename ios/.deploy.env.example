# Credentials for the headless TestFlight pipeline.
# Copy to ios/.deploy.env (gitignored) and fill in. Nothing here is committed.

# App Store Connect API key. The .p8 itself stays in
# ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8 and is never copied
# into the repo; only its id and the team's issuer id live here.
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
# ASC_KEY_PATH=/absolute/path/AuthKey_XXXXXXXXXX.p8   # optional override

# Password for the dedicated signing keychain that bootstrap_signing.sh
# creates. Any long random string; it protects the distribution private key
# at rest on this machine. Generate one with:  openssl rand -base64 24
SIGNING_KEYCHAIN_PASSWORD=change-me
