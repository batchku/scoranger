# user score library and source material — never committed
# (may contain copyrighted scores; the app regenerates workspace/ on first use)
workspace/
# ...and without the slash: a trailing slash matches DIRECTORIES ONLY, so a
# SYMLINK by the same name is not ignored and is one `git add -A` away from
# being committed as an absolute path out of someone's home directory. These
# three paths get linked during development often enough for that to matter.
workspace
intake/

# python
engine/.venv/
engine/.venv
engine/**/__pycache__/
engine/*.egg-info/
engine/scoranger_engine.egg-info/

# node
viewer/node_modules/
viewer/dist/

# misc
.DS_Store
*.log

# secrets
.env
ios/Vendor/
ios/Vendor
ios/PythonApp/app_packages/
ios/PythonApp/app_packages
ios/PythonApp/app/scoranger_engine/
ios/PythonApp/app/scoranger_engine
__pycache__/
.omr-api-key
testdata/
testdata

# headless deploy credentials (see ios/.deploy.env.example)
ios/.deploy.env

# design mockup renders are regenerable via design/shoot*.sh
design/png/

# QA sweep screenshots: copyrighted scores, and large. Kept local only.
design/qa/

# gate run artifacts (per-worker logs, result bundles, shard lists)
ios/build/gate/
ios/DerivedData-Gate/
ios/DerivedData-Baseline/
